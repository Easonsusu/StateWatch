    "Your check-in adds useful context for today's wellness reflection." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "您的狀態記錄為今天的健康生活參考增添有用脈絡。" } } } },
    "Your recent signals look mixed." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "您近期的訊號看起來呈現綜合狀態。" } } } },
    "Your recent signals look steady." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "您近期的訊號看起來穩定。" } } } }
