    "Unknown" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未知" } } } },
    "Used as an optional wellness signal with user context." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "做為選用的健康生活訊號，並參考使用者提供的脈絡。" } } } },
    "Used for sleep score context and gentle suggestions." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用於睡眠分數脈絡與溫和建議。" } } } },
    "Used to balance recovery suggestions with movement." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用於在恢復建議與活動之間取得平衡。" } } } },
    "Used to explain activity load and trend context." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用於說明活動負荷與趨勢脈絡。" } } } },
    "Used to explain when recovery may look lower than usual." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用於說明恢復狀態可能低於平常的情況。" } } } },
    "Used with activity and recovery context when present." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "有資料時，會與活動和恢復脈絡一併參考。" } } } },
    "Watch Check-ins stay on Apple Watch and can be deleted individually there." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple Watch 上的狀態記錄會保留在 Apple Watch，並可在該處逐筆刪除。" } } } },
