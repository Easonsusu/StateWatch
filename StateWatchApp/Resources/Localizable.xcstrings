    "Several mock signals are below the recent baseline." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "數項模擬訊號低於近期基準。" } } } },
    "Seven day trend" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "7 天趨勢" } } } },
    "Shown as one signal in the daily state summary." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在每日狀態摘要中顯示為其中一項訊號。" } } } },
    "Signals" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "訊號" } } } },
    "Sleep" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠" } } } },
    "Sleep Analysis" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠分析" } } } },
    "Sleep baseline history is unavailable, so this score stays cautious." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無可用的睡眠基準記錄，因此此分數會保持謹慎。" } } } },
    "Sleep data is unavailable for today." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "今天沒有可用的睡眠資料。" } } } },
    "Sleep duration is a bit shorter than the mock baseline." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠時間比模擬基準稍短。" } } } },
    "Sleep duration is available, but baseline history is still building." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已有睡眠時間資料，但個人基準記錄仍在建立中。" } } } },
    "Sleep duration is close to your recent pattern." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠時間接近您近期的狀態。" } } } },
    "Sleep duration is near your recent baseline." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠時間接近您近期的個人基準。" } } } },
    "Sleep Duration" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠時間" } } } },
    "Sleep reflects duration, recent trend, and estimated sleep debt compared with your baseline." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠狀態會將時間、近期趨勢與估算的睡眠不足和您的個人基準比較。" } } } },
    "Sleep uses limited baseline history, so this remains a softer wellness estimate." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "睡眠狀態使用的基準記錄有限，因此這仍是較保守的健康生活估計。" } } } },
    "Some health access may be denied or limited. StateWatch can continue with mock data and optional values." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分健康資料存取可能已被拒絕或受限。StateWatch 仍可繼續使用模擬資料與選用數值。" } } } },
    "Some recovery signals are below the mock baseline." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分恢復訊號低於模擬基準。" } } } },
    "Stand Hours" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "站立小時" } } } },
    "StateWatch" : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch" } } } },
    "StateWatch can request read-only Apple Health access or continue with mock data." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 可以要求僅供讀取的 Apple「健康」存取權，或繼續使用模擬資料。" } } } },
    "StateWatch does not request permission to write HealthKit data." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 不會要求寫入 HealthKit 資料的權限。" } } } },
    "StateWatch does not upload Apple Health data to any server in the MVP." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 不會上傳 Apple「健康」資料。" } } } },
    "StateWatch does not upload HealthKit data." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 不會上傳 Apple「健康」資料。" } } } },
    "StateWatch is not a medical device. It does not diagnose, treat, cure, or prevent any disease, and it does not provide medical advice." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 不是醫療器材，不會診斷、治療、治癒或預防任何疾病，也不提供醫療建議。" } } } },
    "StateWatch is not a medical device. It does not diagnose, treat, cure, or prevent any disease, and it does not provide medical advice. If you have medical concerns, consult a qualified healthcare professional." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 不是醫療器材，不會診斷、治療、治癒或預防任何疾病，也不提供醫療建議。如有醫療疑慮，請諮詢合格的醫療專業人員。" } } } },
    "StateWatch requests read-only Apple Health access for local wellness summaries." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 會要求僅供讀取的 Apple「健康」存取權，用於本機健康生活摘要。" } } } },
    "StateWatch uses optional, read-only Apple Health data for local wellness summaries. You can continue with mock data at any time." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "StateWatch 使用選用且僅供讀取的 Apple「健康」資料，在本機產生健康生活摘要。您隨時都可以繼續使用模擬資料。" } } } },
