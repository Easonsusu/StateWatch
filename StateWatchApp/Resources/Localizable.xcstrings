    "HealthKit-derived Dashboard output is not published to Watch, WidgetKit, or the App Group." : { "localizations" : { "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "由 HealthKit 衍生的儀表板結果不會發布到 Apple Watch、WidgetKit 或 App Group。" } } } },
